# Quick deployment Dockerfile — uses pre-compiled binary (glibc)
# For full multi-stage build from source, use Dockerfile instead.
#
# Usage:
#   cargo build --release --bin veyron
#   cp target/release/veyron /tmp/veyron-binary
#   docker build -t veyron:latest -f Dockerfile.deploy /tmp
#
# Match Ubuntu 24.04 build hosts (GLIBC_2.39). bookworm-slim is too old for
# host-built release binaries and crashes with "GLIBC_2.39 not found".
FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# Install virtctl for VNC console proxy
ARG VIRTCTL_VERSION=v1.9.0
RUN curl -sL "https://github.com/kubevirt/kubevirt/releases/download/${VIRTCTL_VERSION}/virtctl-${VIRTCTL_VERSION}-linux-amd64" \
    -o /usr/local/bin/virtctl \
    && chmod +x /usr/local/bin/virtctl

# GuestKit in-guest agent, served to guests at /api/v1/platform/guestkit/binary. Without it that endpoint answers 503 and every
# guest has to fetch the agent from GitHub, which an egress allow-list (user-mode guests) would have to permit. Keep the tag in
# step with GUESTKIT_RELEASE_TAG in src/templates/mod.rs.
ARG GUESTKIT_URL=https://github.com/zyvorai/guestkit/releases/download/guestkit-agent-v0.3.14/guestkitd
RUN curl -fsSL "${GUESTKIT_URL}" -o /usr/local/bin/guestkit \
    && chmod 0755 /usr/local/bin/guestkit

COPY veyron-binary /usr/local/bin/veyron
RUN chmod +x /usr/local/bin/veyron && ln -sf /usr/local/bin/veyron /usr/local/bin/vmrogue

USER 10001

ENTRYPOINT ["veyron"]
CMD ["api-serve", "--port", "5151", "--host", "0.0.0.0"]
