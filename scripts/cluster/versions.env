#
# SINGLE SOURCE OF VERSION TRUTH for the Veyron platform baseline.
#
# Every installer, deploy script, and customer bundle sources this file. Do not
# hardcode component versions anywhere else — the repo previously carried three
# different CDI pins and a KubeVirt pin four minor versions behind what shipped.
#
#   source "$(dirname "$0")/../cluster/versions.env"
#
# Each var is overridable from the environment (V9S_*/VEYRON_* wrappers set them).

# --- Kubernetes ---------------------------------------------------------------
# Deliberately NOT the latest k3s. KubeVirt supports "the latest three Kubernetes
# releases at the time the KubeVirt release is made", so KubeVirt 1.8.x is tested
# against Kubernetes 1.33-1.35. k3s v1.36.x would leave that tested window.
K3S_VERSION="${K3S_VERSION:-v1.35.6+k3s1}"

# --- Virtualization -----------------------------------------------------------
KUBEVIRT_VERSION="${KUBEVIRT_VERSION:-v1.8.4}"   # stable, 2026-06-16
CDI_VERSION="${CDI_VERSION:-v1.65.0}"            # stable, 2026-03-31

# --- Networking ---------------------------------------------------------------
CILIUM_CHART_VERSION="${CILIUM_CHART_VERSION:-1.20.0}"

# --- Storage / snapshots ------------------------------------------------------
SNAPSHOTTER_VERSION="${SNAPSHOTTER_VERSION:-v8.0.0}"
ROOK_VERSION="${ROOK_VERSION:-v1.14.11}"

# --- Cluster add-ons ----------------------------------------------------------
METRICS_SERVER_VERSION="${METRICS_SERVER_VERSION:-v0.7.2}"
MULTUS_VERSION="${MULTUS_VERSION:-v4.0.2}"

# --- GPU passthrough ----------------------------------------------------------
# NVIDIA KubeVirt GPU device plugin. Phase 1 (whole-GPU passthrough) does NOT
# need this image — KubeVirt's built-in permittedHostDevices plugin serves the
# resource. It is deployed only with V9S_INSTALL_NVIDIA_KUBEVIRT_DP=1 as the
# stepping stone to Phase 2 (vGPU mediated devices).
NVIDIA_KUBEVIRT_GPU_DP_IMAGE="${NVIDIA_KUBEVIRT_GPU_DP_IMAGE:-nvcr.io/nvidia/kubevirt-gpu-device-plugin:v1.3.1}"

# --- Multi-site mesh (defaults, not versions) ----------------------------------
V9S_MESH_CIDR="${V9S_MESH_CIDR:-10.88.0.0/24}"
V9S_MESH_PORT="${V9S_MESH_PORT:-51820}"

# --- Windows VirtIO drivers ---------------------------------------------------
# Pinned by DIGEST, not tag: this container disk is auto-attached to every Windows
# VM, so a mutable tag would silently change the driver set under running fleets.
# Digest is the multi-arch OCI index for v1.8.1.
# Re-resolve with:
#   skopeo inspect docker://quay.io/kubevirt/virtio-container-disk:<tag> --format '{{.Digest}}'
VIRTIO_WIN_CONTAINER_DISK="${VIRTIO_WIN_CONTAINER_DISK:-quay.io/kubevirt/virtio-container-disk@sha256:6b823946eb7493347a93d6daa16b4101a68e16a0ee1766e01ac3adf82e4b5838}"
