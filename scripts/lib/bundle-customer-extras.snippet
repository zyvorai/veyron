# Append inside REMOTE_PACK after package-ui.sh is copied to STAGE/.package-lib/
# Replace PRODUCT_* and FINISH_EXTRA_* per product.

cp "\${LIB}/install-everything.sh" "\${STAGE}/"
chmod +x "\${STAGE}/install-everything.sh"
cat > "\${STAGE}/.package-lib/product.meta" <<'META'
PRODUCT_NAME=PRODUCT_NAME_HERE
ACCESS_SCHEME=http
ACCESS_PORT=8080
ACCESS_PATH=
AUTO_FULL_INSTALL=0
FINISH_EXTRA_1=
FINISH_EXTRA_2=
FINISH_EXTRA_3=
META
