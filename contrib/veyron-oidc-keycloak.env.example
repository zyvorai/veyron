# Keycloak SSO for veyron — realm "veyron" at http://HOST:30180
#
# Usage:
#   set -a && source contrib/veyron-oidc-keycloak.env.example && set +a
#   VEYRON_OIDC_CLIENT_SECRET=<paste from Keycloak Credentials tab> \
#     ./scripts/deploy-remote.sh HOST sus --with-oidc

VEYRON_OIDC_ISSUER=http://HOST:30180/realms/veyron
VEYRON_OIDC_CLIENT_ID=veyron
# VEYRON_OIDC_CLIENT_SECRET intentionally NOT set here — pass on the command
# line at deploy time instead. Never commit the real secret.
VEYRON_OIDC_AUTHORIZATION_URL=http://HOST:30180/realms/veyron/protocol/openid-connect/auth
VEYRON_OIDC_TOKEN_URL=http://HOST:30180/realms/veyron/protocol/openid-connect/token
VEYRON_OIDC_JWKS_URL=http://HOST:30180/realms/veyron/protocol/openid-connect/certs
# Resolved against the dashboard origin at login time (see oidcRedirectUri() in
# dashboard.html) — becomes https://HOST:30151/dashboard.
VEYRON_OIDC_REDIRECT_URI=/dashboard
VEYRON_OIDC_ROLE_CLAIM=groups
VEYRON_OIDC_GROUP_ADMIN=veyron-admins,cluster-admins
VEYRON_OIDC_GROUP_WRITE=veyron-write,veyron-editors
