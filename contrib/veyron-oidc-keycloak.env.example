# Keycloak SSO for veyron — realm "veyron" at http://198.51.100.20:30180
#
# Usage:
#   set -a && source contrib/veyron-oidc-keycloak.env.example && set +a
#   VEYRON_OIDC_CLIENT_SECRET=<paste from Keycloak Credentials tab> \
#     ./scripts/deploy-remote.sh 203.0.113.10 admin --with-oidc

VEYRON_OIDC_ISSUER=http://198.51.100.20:30180/realms/veyron
VEYRON_OIDC_CLIENT_ID=veyron
# VEYRON_OIDC_CLIENT_SECRET intentionally NOT set here — pass on the command
# line at deploy time instead. Never commit the real secret.
VEYRON_OIDC_AUTHORIZATION_URL=http://198.51.100.20:30180/realms/veyron/protocol/openid-connect/auth
VEYRON_OIDC_TOKEN_URL=http://198.51.100.20:30180/realms/veyron/protocol/openid-connect/token
VEYRON_OIDC_JWKS_URL=http://198.51.100.20:30180/realms/veyron/protocol/openid-connect/certs
# Resolved against the console origin at login time — becomes https://203.0.113.10:30151/console.
VEYRON_OIDC_REDIRECT_URI=/console
VEYRON_OIDC_ROLE_CLAIM=groups
VEYRON_OIDC_GROUP_ADMIN=veyron-admins,cluster-admins
VEYRON_OIDC_GROUP_WRITE=veyron-write,veyron-editors
